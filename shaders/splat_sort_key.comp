#version 450
#extension GL_GOOGLE_include_directive : require

// Pass 0: compute the sort key (order-preserving view-space depth) for every
// splat and initialise the identity index array in index0 (A). Run once per
// frame, before the four radix passes (which start with src = A).

#include "splat_sort.glsl"

struct GpuSplat { vec4 posOpacity; vec4 color; vec4 cov0; vec4 cov1; };

// Unified set-0 layout, shared by every sort pass.
layout(std430, set = 0, binding = 0) readonly buffer SplatBlock { GpuSplat splats[]; };
layout(std430, set = 0, binding = 1) buffer KeyBlock   { uint keys[]; };
layout(std430, set = 0, binding = 2) buffer Idx0Block  { uint index0[]; };
layout(std430, set = 0, binding = 3) buffer Idx1Block  { uint index1[]; };
layout(std430, set = 0, binding = 4) buffer HistBlock  { uint tileHist[]; };

// set 1: view matrix (truncated, layout-compatible prefix of the globals UBO).
layout(set = 1, binding = 0) uniform GlobalsBlock { mat4 view; mat4 proj; } G;

layout(local_size_x = WG_SIZE) in;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.numElements) return;

    vec4 posV = G.view * vec4(splats[i].posOpacity.xyz, 1.0);
    keys[i]   = keyFromDepth(posV.z);   // ascending key == ascending z == back-to-front
    index0[i] = i;
}
