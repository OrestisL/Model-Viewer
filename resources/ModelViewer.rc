// Windows resource script.
//
// IDI_ICON1 with the lowest numeric ID becomes the executable's icon in
// Explorer, the taskbar and the Alt-Tab switcher. This is separate from the
// runtime window icon set through GLFW: this one is baked into the .exe and is
// visible before the program even runs.
1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ModelViewer"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "ModelViewer"
            VALUE "OriginalFilename","ModelViewer.exe"
            VALUE "ProductName",     "ModelViewer"
            VALUE "ProductVersion",  "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
